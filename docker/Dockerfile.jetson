# Jetson-specific Autoware image.
# The L4T JetPack base provides CUDA, cuDNN, and TensorRT for Tegra.
# setup-dev-env.sh --jetson handles the rest: ROS 2, Autoware deps,
# OpenCV pinning, and building spconv/cumm from source against JetPack CUDA.
#
# This Dockerfile MUST be built on an aarch64 host (Jetson device).

ARG L4T_VERSION=r36.4.0
ARG ROS_DISTRO=humble

# ============================================================
# Stage 1 – Autoware dependencies
# ============================================================
# hadolint ignore=DL3006
FROM nvcr.io/nvidia/l4t-jetpack:${L4T_VERSION} AS jetson-deps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG ROS_DISTRO

COPY setup-dev-env.sh ansible-galaxy-requirements.yaml amd64.env arm64.env /autoware/
COPY ansible/ /autoware/ansible/
COPY docker/scripts/cleanup_apt.sh /autoware/cleanup_apt.sh
RUN chmod +x /autoware/cleanup_apt.sh
WORKDIR /autoware

RUN echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/99-disable-extra-packages \
    && echo 'APT::Install-Suggests "false";' >> /etc/apt/apt.conf.d/99-disable-extra-packages

# libnvinfer.so has a transitive link-time dependency on libnvdla_compiler.so, which lives
# in /usr/lib/aarch64-linux-gnu/nvidia/ — a non-standard path not covered by ldconfig in
# the base image. Register it so the linker can find it when building TensorRT-dependent packages.
RUN echo "/usr/lib/aarch64-linux-gnu/nvidia" > /etc/ld.so.conf.d/nvidia-tegra.conf \
    && ldconfig

# Install all Autoware dependencies.
# --jetson:
#   - Pins OpenCV to the Autoware-compatible version (NVIDIA's build is missing required functions)
#   - Builds spconv/cumm from source against JetPack CUDA (pre-built binaries target CUDA 12.8)
#   - Disables agnocast (incompatible with L4T kernel, causes kernel panic on host)
#   - Skips CUDA/TensorRT installation (already provided by the L4T base image)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    ./setup-dev-env.sh --jetson -y \
    && pipx uninstall ansible \
    && /autoware/cleanup_apt.sh

# ============================================================
# Stage 2 – Autoware source build
# ============================================================
FROM jetson-deps AS jetson-devel
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG ROS_DISTRO
ENV CCACHE_DIR="/root/.ccache"

COPY docker/scripts/build_and_clean.sh /autoware/build_and_clean.sh
RUN chmod +x /autoware/build_and_clean.sh

# gosu is used by the entrypoint to optionally drop to a non-root user
# hadolint ignore=DL3008
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends gosu \
    && /autoware/cleanup_apt.sh

# Install rosdep dependencies (scans all package.xml files in src/)
# apt-get update is required because cleanup_apt.sh wiped /var/lib/apt/lists/ at end of stage 1.
# hadolint ignore=SC2002,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=bind,source=src,target=/autoware/src \
    apt-get update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -y --rosdistro "${ROS_DISTRO}" \
    && /autoware/cleanup_apt.sh

# Register colcon mixins (release, compile-commands, ccache) used by build_and_clean.sh
RUN colcon mixin add default \
        https://raw.githubusercontent.com/colcon/colcon-mixin-repository/master/index.yaml \
    && colcon mixin update default

# Build all packages
# hadolint ignore=SC1091
RUN --mount=type=cache,target="${CCACHE_DIR}" \
    --mount=type=bind,source=src,target=/autoware/src \
    source /opt/ros/"${ROS_DISTRO}"/setup.bash \
    && /autoware/build_and_clean.sh "${CCACHE_DIR}" /opt/autoware \
        "--cmake-args -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined -DCMAKE_SHARED_LINKER_FLAGS=-Wl,--allow-shlib-undefined"

COPY docker/etc/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]
